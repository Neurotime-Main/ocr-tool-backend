generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum HighlightSource {
  AUTO
  MANUAL
}

/// Per-page work state. Pages are the unit the workers claim, so a document's
/// progress, its retries and its partial failures are all derived from these.
enum PageStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model Document {
  id           String      @id @default(cuid())
  originalName String
  storageKey   String      @unique
  mimeType     String      @default("application/pdf")
  size         Int
  pageCount    Int?
  ocrStatus    OcrStatus   @default(PENDING)
  ocrLanguage  String      @default("eng")
  ocrMode      String      @default("AUTO")
  ocrError     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pages        OcrPage[]
  highlights   Highlight[]
}

model OcrPage {
  id         String     @id @default(cuid())
  documentId String
  pageNumber Int
  width      Float      @default(0)
  height     Float      @default(0)
  source     String     @default("pending")
  text       String     @default("") @db.Text
  words      Json       @default("[]")
  /// The page's text after the same normalisation the keyword matcher applies,
  /// with spaces removed. Kept alongside `text` so a search can rule a page out
  /// in the database, on a trigram index, instead of loading every word box in
  /// the batch into the API process to find out it matched nothing.
  searchText String     @default("") @db.Text
  status     PageStatus @default(COMPLETE)
  attempts   Int        @default(0)
  error      String?
  /// Identifies the worker holding this page, so a lock left behind by a
  /// redeployed or killed worker can be told apart from live work.
  lockedBy   String?
  startedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
  /// The claim query orders pending pages by age; this is the index it rides.
  @@index([status, createdAt])
}

model Highlight {
  id         String          @id @default(cuid())
  documentId String
  pageNumber Int
  x          Float
  y          Float
  width      Float
  height     Float
  color      String          @default("#FDE047")
  opacity    Float           @default(0.38)
  source     HighlightSource
  keyword    String?
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNumber])
}
