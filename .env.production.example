# Server configuration. Copy to .env.production and fill in the blanks.
#
#   cp .env.production.example .env.production
#   docker compose up -d --build
#
# Only what the server needs is here. Paths inside the container (PYTHON_BIN,
# STORAGE_DIR, TEMP_DIR, PPOCR_MODEL_DIR) are set by docker-compose.yml and must
# not be repeated here -- a value copied from a developer's machine names a
# directory the container does not have, and every page then fails on a
# recogniser that cannot start.

# --- Required -----------------------------------------------------------------

# Where the browser loads the app from. Comma-separated, no trailing slash.
CLIENT_ORIGIN=https://ocr.example.com

# Object storage for published page images. These are public objects that
# readers open from media_results, so they have to outlive this container.
# Use a Spaces access key, not an AWS IAM one.
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://ams3.digitaloceanspaces.com
DO_SPACES_REGION=ams3
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_FORCE_PATH_STYLE=true
# The SDK frames PutObject as 'aws-chunked' to append a trailing checksum,
# which Spaces rejects.
DO_SPACES_DISABLE_CHECKSUMS=true
# A prefix inside the Space for the published images.
MEDIA_IMAGE_PREFIX=newspaper

# The Neurotime database. Source of keywords and projects, and where published
# mentions are written. Without these the service still starts and reads
# documents, but the keyword list is empty and publishing answers 503.
SERVER_DB_HOST=
SERVER_DB_PORT=5432
SERVER_DB_USER=
SERVER_DB_PASSWORD=
SERVER_DB_NAME=media_analyse
SERVER_DB_SSLMODE=disable

# --- Optional -----------------------------------------------------------------
# Defaults shown. Uncomment only to change one.

# Newspapers. Keywords are offered for this source type and every published row
# is stamped with it.
# NEWS_SOURCE_TYPE_ID=10

# Uploads. MAX_UPLOAD_MB is per file; a batch can carry MAX_BATCH_FILES of them
# in one request, so the reverse proxy's body limit has to allow the product.
# MAX_UPLOAD_MB=50
# MAX_BATCH_FILES=30

# How many documents stay in memory before the oldest finished ones are
# dropped. There is no database, so this is what bounds the heap.
# OCR_MAX_RETAINED_DOCUMENTS=200

# Recognition. Both are sized from the container's CPU limit by default, and
# concurrency x threads should stay near the core count -- measured on a
# 12-thread/6-core host, two pages at three threads read eight pages in 88s
# where six pages at one thread each took 196s.
# OCR_CONCURRENCY=2
# PPOCR_THREADS=3

# Rasterisation. 1600 reads dense body copy; 1280 is about a third faster and
# loses the smallest text.
# OCR_RENDER_DPI=200
# PPOCR_DET_MAX_SIDE=1600

# How much garbled text a PDF may carry before its own text layer is thrown
# away and the page is recognised from the raster instead. Lower means more
# accurate text and much more recognition time.
# OCR_BROKEN_ENCODING_PAGE=0.02
# OCR_BROKEN_ENCODING_DOCUMENT=0.5
