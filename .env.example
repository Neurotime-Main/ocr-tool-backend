NODE_ENV="development"
PORT=4000

# Neon pooled connection used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

CLIENT_ORIGIN="http://localhost:5173,https://your-app.vercel.app"

STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
TEMP_DIR="./tmp"

AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-private-bucket"
AWS_S3_PREFIX="documents"
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are required when using S3.

# eng, aze, and aze+eng are bundled and always enabled. "aze+eng" runs both
# language models over every line and is roughly 1.7x slower than "aze" alone.
TESSERACT_LANGS="eng,aze,aze+eng"
# TESSDATA_PATH="/absolute/path/to/extra/tessdata"
# 260 is a good accuracy/performance balance. Use 300 for difficult scans.
OCR_RENDER_DPI=260
# Pages whose box is far larger than A4 are rendered below OCR_RENDER_DPI so a
# single page never rasterises past this many pixels. A4 at 260 DPI is 6.5 MP,
# so normal pages are unaffected.
OCR_MAX_PAGE_PIXELS=12000000
OCR_MIN_RENDER_DPI=150
# Parallel page recognitions shared by the whole batch. Unset means the
# smaller of "CPU cores - 1" and what free memory allows, capped at 8. Each
# Tesseract worker holds its language models and a WASM heap, so a small
# container is deliberately kept near 1.
# OCR_CONCURRENCY=4
# OCR_DOCUMENT_CONCURRENCY=4
# OCR_RENDER_CONCURRENCY=2
UPLOAD_STORAGE_CONCURRENCY=4
MAX_UPLOAD_MB=50
MAX_BATCH_FILES=30
