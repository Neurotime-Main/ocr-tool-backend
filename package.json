{
  "name": "ocr-highlight-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/doctor.ts",
    "setup:python": "bash scripts/setup-python.sh",
    "inspect:server-db": "tsx src/inspectServerDb.ts",
    "write-env": "node scripts/write-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@smithy/node-http-handler": "^4.11.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
